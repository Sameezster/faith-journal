# --- App ---
ENVIRONMENT=dev
CORS_ORIGINS=["*"]

# --- AI (Gemini default; leave keys blank to run on keyword fallback) ---
AI_PROVIDER=gemini
AI_TIMEOUT_MS=2500
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Bible ---
BIBLE_DATA_DIR=data/bibles
DEFAULT_TRANSLATION=KJV

# --- Firebase (token verification; relaxed in dev) ---
AUTH_REQUIRED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Database (Bible + taxonomy/telemetry) ---
DATABASE_URL=sqlite+aiosqlite:///./faith_journal.db
